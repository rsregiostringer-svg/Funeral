# ==================================================
# ALAALA FUNERAL HOMES MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==================================================

# Django Core Settings
DJANGO_SECRET_KEY=your-production-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-production-domain.com

# Database Configuration
# Leave DATABASE_URL empty to use local development SQLite (db.sqlite3)
# For Production PostgreSQL, specify DATABASE_URL or individual DB_* variables:
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/alaala_db
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# CORS & CSRF Trusted Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Session Settings (Minutes)
ALAALA_IDLE_TIMEOUT_MINUTES=3
ALAALA_INACTIVE_TIMEOUT_MINUTES=15
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# Initial Master Admin Setup (Optional for automated headless setup)
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_FULL_NAME=
MASTER_ADMIN_PASSWORD=

# Frontend Vite Configuration
VITE_API_URL=http://127.0.0.1:8000/api
